<!doctype html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body>

  <!-- ============ LANDING PAGE ============ -->
  <div id="page-landing">
    <nav class="site-nav">
      <span class="nav-logo"><%- include('partials/logo-icon') %>Snapain</span>
      <div class="nav-links">
        <a href="#section-how">How It Works</a>
        <a href="#section-showcase">Layouts</a>
        <a href="#section-how">Frames</a>
        <a href="#section-cta">Snap</a>
      </div>
      <button class="btn-nav-cta" id="navStartBtn">Start Booth</button>
    </nav>

    <header class="hero">
      <p class="hero-eyebrow">The modern photobooth experience</p>
      <h1 class="hero-title">Capture the Joy with <span>Snapain</span></h1>
      <p class="hero-sub">Photobooth digital yang playful langsung dari browser — pilih template, jepret langsung atau upload dari galeri, lalu download. Tanpa install, tanpa daftar.</p>
      <button class="btn-hero-cta" id="heroStartBtn">Start Booth</button>
    </header>

    <section class="showcase" id="section-showcase">
      <div class="showcase-card tilt-left">
        <div class="showcase-strip">
          <span class="showcase-shot"></span>
          <span class="showcase-shot"></span>
          <span class="showcase-shot"></span>
        </div>
      </div>
      <div class="showcase-card">
        <div class="showcase-strip showcase-strip--grid">
          <span class="showcase-shot"></span>
          <span class="showcase-shot"></span>
          <span class="showcase-shot"></span>
          <span class="showcase-shot"></span>
        </div>
      </div>
      <div class="showcase-card tilt-right">
        <div class="showcase-strip">
          <span class="showcase-shot"></span>
          <span class="showcase-shot"></span>
        </div>
      </div>
    </section>

    <section class="how-it-works" id="section-how">
      <h2>How It Works</h2>
      <p class="section-sub">Tiga langkah gampang buat foto strip kamu sendiri.</p>
      <div class="how-grid">
        <div class="how-card">
          <span class="how-badge how-badge--a">1</span>
          <h3>Choose Template</h3>
          <p>Klik langsung template grid + frame yang kamu suka, nggak perlu pilih nama-nama.</p>
        </div>
        <div class="how-card">
          <span class="how-badge how-badge--b">2</span>
          <h3>Pick a Filter</h3>
          <p>Kasih efek warna favorit kamu ke hasil fotonya.</p>
        </div>
        <div class="how-card">
          <span class="how-badge how-badge--c">3</span>
          <h3>Snap or Upload</h3>
          <p>Jepret langsung dari kamera atau pilih foto dari galeri, lalu download hasilnya.</p>
        </div>
      </div>
    </section>

    <section class="cta-banner" id="section-cta">
      <h2>Ready to start snapping?</h2>
      <p>Langsung masuk ke booth dan mulai jepret, nggak perlu daftar akun.</p>
      <button class="btn-cta-banner" id="ctaStartBtn">Launch Snapain Booth</button>
    </section>

    <footer class="landing-footer">
      <span class="footer-logo"><%- include('partials/logo-icon') %>Snapain</span>
      <div class="footer-links">
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Service</a>
        <a href="#">Contact Support</a>
      </div>
      <p class="footer-copy">Snapain &mdash; momen kecil, kenangan selamanya.</p>
    </footer>
  </div>

  <!-- ============ BOOTH WIZARD ============ -->
  <div id="app" class="hidden">
    <header class="app-topbar">
      <button class="app-back" id="btnExitBooth" type="button" aria-label="Kembali">&lsaquo;</button>
      <ol class="stepper" id="stepper">
        <li class="step active" data-step="1"><span class="step-dot">1</span><span class="step-label">Template</span></li>
        <li class="step-line"></li>
        <li class="step" data-step="2"><span class="step-dot">2</span><span class="step-label">Filter</span></li>
        <li class="step-line"></li>
        <li class="step" data-step="3"><span class="step-dot">3</span><span class="step-label">Foto</span></li>
        <li class="step-line"></li>
        <li class="step" data-step="4"><span class="step-dot">4</span><span class="step-label">Save</span></li>
      </ol>
    </header>

    <main class="stage-card">

      <!-- ===== STEP 1: TEMPLATE (grid + frame combined, visual only) ===== -->
      <section class="screen" id="screen-template">
        <h2 class="screen-title">Choose Your Template</h2>
        <p class="screen-sub">Klik langsung template yang kamu suka.</p>
        <div class="template-grid" id="templateRow"></div>
        <button id="btnTemplateNext" class="btn-wizard-primary btn-wizard-primary--end">Next Step &rarr;</button>
      </section>

      <!-- ===== STEP 2: FILTER ===== -->
      <section class="screen hidden" id="screen-filter">
        <h2 class="screen-title">Pilih Filter</h2>
        <p class="screen-sub">Efek warna buat hasil fotomu.</p>
        <div class="swatch-grid swatch-grid--filters" id="filterRow">
          <button class="swatch-card filter-chip active" data-filter="normal" data-css="none">
            <span class="swatch-preview swatch-preview--filter"></span>
            <span class="swatch-label">Normal</span>
          </button>
          <button class="swatch-card filter-chip" data-filter="bw" data-css="grayscale(1)">
            <span class="swatch-preview swatch-preview--filter" style="filter:grayscale(1);"></span>
            <span class="swatch-label">B&amp;W</span>
          </button>
          <button class="swatch-card filter-chip" data-filter="sepia" data-css="sepia(0.8)">
            <span class="swatch-preview swatch-preview--filter" style="filter:sepia(0.8);"></span>
            <span class="swatch-label">Sepia</span>
          </button>
          <button class="swatch-card filter-chip" data-filter="vintage" data-css="sepia(0.35) contrast(1.1) brightness(1.05) saturate(1.2)">
            <span class="swatch-preview swatch-preview--filter" style="filter:sepia(0.35) contrast(1.1) brightness(1.05) saturate(1.2);"></span>
            <span class="swatch-label">Vintage</span>
          </button>
          <button class="swatch-card filter-chip" data-filter="soft" data-css="brightness(1.12) saturate(1.35) contrast(0.95)">
            <span class="swatch-preview swatch-preview--filter" style="filter:brightness(1.12) saturate(1.35) contrast(0.95);"></span>
            <span class="swatch-label">Soft Glow</span>
          </button>
        </div>
        <div class="wizard-actions">
          <button id="btnFilterBack" class="btn-wizard-secondary">&larr; Back</button>
          <button id="btnFilterNext" class="btn-wizard-primary">Next Step &rarr;</button>
        </div>
      </section>

      <!-- ===== STEP 3: FOTO (live capture or pick from gallery) ===== -->
      <section class="screen hidden" id="screen-booth">
        <div class="source-toggle" id="sourceToggle">
          <button class="source-btn active" type="button" data-source="camera">Ambil Foto</button>
          <button class="source-btn" type="button" data-source="gallery">Pilih dari Galeri</button>
        </div>

        <div class="source-panel" id="panel-camera">
          <div class="camera-wrap">
            <video id="video" autoplay playsinline muted></video>
            <div class="countdown-overlay" id="countdownOverlay"></div>
            <div class="flash" id="flashEl"></div>
            <p class="cam-hint hidden" id="camHint">Izinkan akses kamera untuk mulai.</p>
          </div>
          <button id="btnCapture" class="btn-capture-circle" type="button" aria-label="Mulai ambil foto"></button>
          <p class="shot-progress" id="shotProgress">Tekan tombol untuk mulai (0/4)</p>
          <p class="retake-hint hidden" id="retakeHint">Klik tombol Ulang pada foto yang ingin diambil ulang.</p>
          <div class="thumbs" id="thumbsRow"></div>
        </div>

        <div class="source-panel hidden" id="panel-gallery">
          <input type="file" id="galleryInput" accept="image/*" multiple class="hidden" />
          <div class="gallery-grid" id="galleryThumbsRow"></div>
          <p class="gallery-hint" id="galleryHint">Pilih foto dari galeri kamu.</p>
        </div>

        <div class="wizard-actions-stack" id="snapActions">
          <button id="btnContinue" class="btn-wizard-primary hidden">Lanjut ke Hasil</button>
          <div class="wizard-actions">
            <button id="btnCaptureBack" class="btn-wizard-secondary">&larr; Back</button>
            <button id="btnRetakeAll" class="btn-wizard-secondary hidden">Ulangi Semua</button>
          </div>
        </div>
      </section>

      <!-- ===== RESULT ===== -->
      <section class="screen hidden" id="screen-result">
        <h2 class="screen-title">Hasil Foto</h2>
        <div class="result-canvas-wrap">
          <canvas id="resultCanvas"></canvas>
        </div>
        <div class="result-actions">
          <button id="btnDownload" class="btn-wizard-primary">Download</button>
          <button id="btnRetake" class="btn-wizard-secondary">Ulangi</button>
        </div>
      </section>

    </main>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>
